{
	"name": "fireflux",
	"version": "0.1.0",
	"description": "Firefly 博客本地管理客户端：动态发布、文章管理、配置图形化修改、一键推送上线",
	"main": "./out/main/index.js",
	"author": "Firefly",
	"private": true,
	"dependencies": {
		"ts-morph": "^23.0.0"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^5.1.0",
		"@types/node": "^22.15.21",
		"electron": "^37.0.0",
		"electron-builder": "^26.15.3",
		"electron-vite": "^3.1.0",
		"highlight.js": "^11.12.0",
		"katex": "^0.18.7",
		"marked": "^18.0.13",
		"marked-highlight": "^2.2.4",
		"marked-katex-extension": "^5.1.13",
		"mermaid": "^12.0.0",
		"pinyin-pro": "^3.29.0",
		"svelte": "^5.30.0",
		"svelte-check": "^4.7.6",
		"tsx": "^4.23.15",
		"typescript": "^5.8.3",
		"vite": "^6.3.5"
	},
	"scripts": {
		"dev": "chcp 65001 && electron-vite dev",
		"build": "electron-vite build",
		"preview": "electron-vite preview",
		"start": "electron .",
		"dist": "electron-vite build && electron-builder --win --publish never",
		"typecheck": "tsc --noEmit -p tsconfig.json",
		"check:svelte": "svelte-check --tsconfig ./tsconfig.json --threshold error",
		"test:rendering": "tsx --test tests/rendering.test.mjs"
	},
	"build": {
		"appId": "com.fireflux.app",
		"productName": "Fireflux",
		"directories": {
			"output": "release"
		},
		"files": [
			"out/**/*"
		],
		"win": {
			"target": [
				{
					"target": "nsis",
					"arch": [
						"x64"
					]
				},
				{
					"target": "zip",
					"arch": [
						"x64"
					]
				}
			],
			"icon": "build/icon.png",
			"artifactName": "fireflux-${version}-${arch}.${ext}"
		},
		"nsis": {
			"oneClick": false,
			"allowToChangeInstallationDirectory": true,
			"artifactName": "fireflux-${version}-setup.${ext}"
		}
	}
}
